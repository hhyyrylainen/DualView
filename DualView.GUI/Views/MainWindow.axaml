<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualView.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:DualView.GUI.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="DualView.GUI.Views.MainWindow"
        Width="720" Height="800"
        MinWidth="300" MinHeight="200"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="DualView - Collection">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
        <!-- Main content area -->

        <!-- Path display and "UP" button -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto, *" Margin="5 5 5 0">
            <TextBlock Grid.Column="0" VerticalAlignment="Center">Path:</TextBlock>
            <Button Grid.Column="1" Content="UP" Command="{Binding NavigateUp}" Margin="0 0 5 0" />
            <TextBox Grid.Column="2" Text="{Binding CurrentPath}" VerticalAlignment="Center">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding Refresh}" />
                </TextBox.KeyBindings>
            </TextBox>
        </Grid>

        <!-- Search box and recursive search -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="5 2 5 2">
            <!-- TODO: make this update search also on typing (but with rate limiting / debouncing) -->
            <TextBox Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search..." Margin="0 0 5 0">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding Refresh}" />
                </TextBox.KeyBindings>
            </TextBox>
            <CheckBox Grid.Column="1" Content="Recursive" IsChecked="{Binding IsRecursiveSearch}" />
        </Grid>

        <!-- Collection header -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="5 2 5 2" IsVisible="{Binding IsInCollection}">
            <TextBlock Grid.Column="0" Text="{Binding CurrentCollectionName, StringFormat='Collection: {0}'}" 
                       VerticalAlignment="Center" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="Full View" Command="{Binding OpenFullView}" />
        </Grid>

        <!-- Important to not follow focus as otherwise it just jumps all over the place when items are interacted with and new ones added -->
        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      BringIntoViewOnFocusChange="False">
            <ItemsControl ItemsSource="{Binding MainItems}" Padding="1 5 10 10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:MediaViewer Margin="5" Width="128" Height="196" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom bar with status and buttons -->
        <Grid Grid.Row="4"
              ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto, Auto, Auto, Auto"
              Background="#F0F0F0"
              Height="40"
              ZIndex="2">

            <ContentControl Grid.Column="0" Margin="6,0"
                            VerticalAlignment="Center" DataContext="{Binding Hamburger}">
                <controls:HamburgerMenuControl />
            </ContentControl>

            <!-- Status text -->
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusText}"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0" />

            <!-- Pagination controls -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Content="&lt;" Command="{Binding GoToPreviousPage}" IsEnabled="{Binding CanNavigateBackwards}" />
                <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="5,0" />
                <TextBlock Text="/" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="5,0" />
                <Button Content="&gt;" Command="{Binding GoToNextPage}" IsEnabled="{Binding CanNavigateForwards}" />
            </StackPanel>

            <!-- Spacer -->
            <Grid Grid.Column="2" />

            <!-- Action buttons -->
            <Button Grid.Column="6"
                    Content="Settings"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Command="{Binding OpenSettings}" />

            <Button Grid.Column="7"
                    Content="Upload"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Command="{Binding OpenUploadWindow}" />

            <Button Grid.Column="8"
                    Content="Import"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Command="{Binding OpenImportWindow}" />
        </Grid>
    </Grid>
</Window>
