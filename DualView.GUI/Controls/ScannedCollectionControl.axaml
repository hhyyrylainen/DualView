<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DualView.GUI.ViewModels"
             xmlns:controls="using:DualView.GUI.Controls"
             x:Class="DualView.GUI.Controls.ScannedCollectionControl"
             x:DataType="vm:ScannedCollectionViewModel">
    <Border BorderBrush="Gray" BorderThickness="1" Margin="4" Padding="4">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" Height="34">
                <AutoCompleteBox x:Name="TargetNameInput" Grid.Column="0" Text="{Binding TargetName}"
                                 ItemsSource="{Binding TargetNameSuggestions}"
                                 MinimumPrefixLength="3"
                                 FilterMode="None"
                                 SelectedItem="{Binding SelectedTargetName}"
                                 TextChanged="OnTargetNameTextChanged" />
                <Button Grid.Column="1" Margin="4,0" Content="Pause" Command="{Binding PauseAsync}"
                        IsVisible="{Binding CanPause}" />
                <Button Grid.Column="2" Margin="4,0" Content="Resume" Command="{Binding ResumeAsync}"
                        IsVisible="{Binding CanResume}" />
                <Button Grid.Column="3" Margin="4,0" Content="Accept" Click="OnAcceptClick"
                        Background="#2878D0" />
                <Button Grid.Column="4" Margin="4,0" Content="Delete" Command="{Binding DeleteAsync}"
                        Background="#C62828" />
            </Grid>
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*">
                <Button Grid.Column="0" Margin="2" Command="{Binding SelectAllAsync}">Select All</Button>
                <Button Grid.Column="1" Margin="2" Command="{Binding DeselectAllAsync}">Deselect All</Button>
                <TextBlock Grid.Column="2" Text="{Binding ScanError}" Foreground="DarkRed" TextWrapping="Wrap"
                           IsVisible="{Binding ScanFailed}" Margin="2,20,2,2" />
            </Grid>
            <ScrollViewer Grid.Row="2" MinHeight="150" MaxHeight="500">
                <ItemsControl ItemsSource="{Binding Media}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:MediaViewer Width="{Binding CustomWidth}" Height="{Binding CustomHeight}"
                                                  Margin="2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="2">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Margin="0,0,8,0"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentlyScannedUrl}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Stretch" TextAlignment="Right"
                           VerticalAlignment="Center" ToolTip.Tip="{Binding CurrentlyScannedUrl}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
