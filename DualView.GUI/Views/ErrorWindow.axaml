<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualView.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="250"
        Width="500" Height="300"
        x:Class="DualView.GUI.Views.ErrorWindow"
        x:DataType="vm:ErrorWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="{Binding Title}">

    <Design.DataContext>
        <vm:ErrorWindowViewModel/>
    </Design.DataContext>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Text="{Binding ErrorMessage}"
                   TextAlignment="Center" Margin="2 3"/>

        <Button DockPanel.Dock="Bottom" HorizontalAlignment="Center" Name="CopyErrorButton">
            Copy Exception
        </Button>

        <ScrollViewer IsVisible="{Binding Details,Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Margin="3 5" HorizontalScrollBarVisibility="Auto" AllowAutoHide="False">
            <TextBlock Text="{Binding Details}" Margin="0 0 0 5"/>
        </ScrollViewer>
    </DockPanel>
</Window>
