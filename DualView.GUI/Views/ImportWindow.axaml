<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualView.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:DualView.GUI.Controls"
        Width="1200" Height="800" MinWidth="600" MinHeight="300"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="450"
        x:Class="DualView.GUI.Views.ImportWindow"
        x:DataType="vm:ImportWindowViewModel"
        Icon="/Assets/logo.ico" Title="DualView - Importer">
    <Design.DataContext>
        <vm:ImportWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,3,*">
        <Grid Grid.Column="0" Width="250" IsVisible="{Binding SidePanelOpen}">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto">
                    <ContentControl DataContext="{Binding Hamburger}">
                        <controls:HamburgerMenuControl />
                    </ContentControl>
                    <Button Grid.Column="1" Command="{Binding ToggleSidePanel}">&lt;</Button>
                </Grid>
                <TextBox Grid.Row="1" Margin="4" Text="{Binding SearchText}" KeyDown="SearchKeyDown"
                         PlaceholderText="Search or create section" />
                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding RecentNames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentImportSectionViewModel">
                                <Button HorizontalContentAlignment="Stretch" Command="{Binding Activate}"
                                        Content="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <CheckBox Grid.Row="3" Margin="4" IsChecked="{Binding TargetNewSection}">Target new section</CheckBox>
            </Grid>
        </Grid>
        <Button Grid.Column="0" Width="25" HorizontalAlignment="Left" VerticalAlignment="Top"
                IsVisible="{Binding !SidePanelOpen}" Command="{Binding ToggleSidePanel}">
            &gt;
        </Button>
        <Border Grid.Column="1" Width="1" Background="Black" />
        <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="4">
                <ToggleButton IsChecked="{Binding ImportTabSelected}" Command="{Binding SelectImportTab}">Import</ToggleButton>
                <ToggleButton IsChecked="{Binding ScanTabSelected}" Command="{Binding SelectScanTab}">Scan</ToggleButton>
                <ToggleButton IsChecked="{Binding StatusTabSelected}" Command="{Binding SelectStatusTab}">Status</ToggleButton>
                <ToggleButton IsChecked="{Binding MissingTagsTabSelected}" Command="{Binding SelectMissingTagsTab}"
                              Content="{Binding MissingTagsHeader}" />
                <Button Command="{Binding OpenUploadWindow}">Upload media</Button>
            </StackPanel>
            <!-- This extra padding is room for the scrollbar -->
            <ScrollViewer Grid.Row="1" IsVisible="{Binding ImportTabSelected}"
                          VerticalScrollBarVisibility="Visible" Padding="0 0 10 3">
                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ImportSectionControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="1" IsVisible="{Binding ScanTabSelected}"
                       Text="Scanning is not implemented yet."
                       Margin="12" />
            <TextBlock Grid.Row="1" IsVisible="{Binding StatusTabSelected}"
                       Text="Import status will appear here."
                       Margin="12" />
            <Grid Grid.Row="1" IsVisible="{Binding MissingTagsTabSelected}" RowDefinitions="Auto,*" Margin="12">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Clear current detections" Command="{Binding ClearCurrentMissingTagDetectionsAsync}" />
                    <Button Content="Reset ignored tags" Command="{Binding ResetIgnoredTagsAsync}" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding MissingTags}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MissingTagViewModel}">
                            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4">
                                <TextBlock Text="{Binding Tag}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Ignore" Command="{Binding Ignore}" Margin="8,0" />
                                <Button Grid.Column="2" Content="Create" Command="{Binding Create}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</Window>
