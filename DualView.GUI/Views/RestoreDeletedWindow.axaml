<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualView.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:DualView.GUI.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="850" Height="800"
        MinHeight="300" MinWidth="450"
        x:Class="DualView.GUI.Views.RestoreDeletedWindow"
        x:DataType="vm:RestoreDeletedWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="DualView - Restore Deleted">

    <Design.DataContext>
        <vm:RestoreDeletedWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto">
        <TabControl Margin="3" SelectedIndex="{Binding TabIndex}">
            <TabItem Header="Folders">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DeletedFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,10,0,0" CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Padding="5">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="10 0" Text="{Binding DeletedAt}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Command="{Binding Restore}">Restore</Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Collections">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DeletedCollections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,10,0,0" CornerRadius="5" BorderBrush="Gray" BorderThickness="1" Padding="5">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="10 0" Text="{Binding DeletedAt}" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Command="{Binding Restore}">Restore</Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Media">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding DeletedMedia}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,10,0,0"
                                        CornerRadius="5"
                                        BorderBrush="Gray" BorderThickness="1"
                                        Padding="5">
                                    <StackPanel>
                                        <TextBlock Text="{Binding OriginalFileName}" FontWeight="Bold" />
                                        <ItemsControl ItemsSource="{Binding Configurations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <controls:MediaViewer DataContext="{Binding Viewer}" Width="64" Height="92" Margin="5" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Margin="10 0"
                                                                   Text="{Binding DeletedAt}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="3" Command="{Binding Restore}">Restore</Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <ContentControl DataContext="{Binding Hamburger}">
                <controls:HamburgerMenuControl />
            </ContentControl>
        </StackPanel>
    </Grid>
</Window>
