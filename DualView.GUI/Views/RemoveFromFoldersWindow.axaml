<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DualView.GUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="DualView.GUI.Views.RemoveFromFoldersWindow"
        x:DataType="vm:RemoveFromFoldersWindowViewModel"
        Title="Remove from Folders"
        Width="400" Height="300" WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:RemoveFromFoldersWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto" Margin="10">
        <TextBlock Text="{Binding ItemName, StringFormat='Uncheck folders to remove \'{0}\' from:'}" Margin="0,0,0,10" />

        <ListBox Grid.Row="1" ItemsSource="{Binding Folders}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Path}" IsChecked="{Binding Keep}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Apply" Command="{Binding Apply}" Classes="accent" />
            <Button Content="Cancel" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
