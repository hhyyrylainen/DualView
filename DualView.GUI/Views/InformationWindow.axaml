<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualView.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="400" Height="200"
        x:Class="DualView.GUI.Views.InformationWindow"
        x:DataType="vm:InformationWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="{Binding Title}">

    <Design.DataContext>
        <vm:InformationWindowViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Grid.ColumnSpan="3" TextWrapping="Wrap" Text="{Binding Message}"
                   TextAlignment="Center" Margin="5"/>

        <Button Grid.Row="2" Grid.Column="1" DockPanel.Dock="Bottom" HorizontalAlignment="Center" Name="CloseButton" Margin="2">
            Close
        </Button>
    </Grid>
</Window>
