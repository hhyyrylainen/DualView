<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DualView.GUI.ViewModels"
        xmlns:controls="using:DualView.GUI.Controls"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="DualView.GUI.Views.UploadWindow"
        x:DataType="vm:UploadWindowViewModel"
        Title="Upload Files"
        Width="800" Height="500" WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:UploadWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="10">
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Stretch">
            <Button Content="Add Files" Click="OnAddFilesClick" IsEnabled="{Binding !IsUploading}" />
            <CheckBox IsChecked="{Binding DeleteAfterUpload}">Delete FILES After Upload</CheckBox>

            <TextBox PlaceholderText="Upload section name (optional, blank means current section)"
                     Text="{Binding UploadSectionName}" HorizontalAlignment="Stretch" />
        </StackPanel>


        <ListBox Grid.Row="1" ItemsSource="{Binding FilesToUpload}" Margin="0,10,0,10">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="160" Margin="5">
                        <ContentControl DataContext="{Binding ThumbnailViewer}">
                            <controls:MediaViewer Height="160" />
                        </ContentControl>
                        <TextBlock Text="{Binding Status}" TextAlignment="Center" FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ProgressBar Grid.Row="2" Value="{Binding TotalProgress}" Minimum="0" Maximum="1"
                     IsVisible="{Binding IsUploading}" Margin="0,0,0,10" />

        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" HorizontalAlignment="Stretch" ColumnSpacing="10">
            <CheckBox Grid.Column="0" IsChecked="{Binding RemoveAfterUpload}">Remove after upload</CheckBox>
            <Button Grid.Column="2" Content="Remove Selected" Command="{Binding RemoveSelectedFiles}" />
            <Button Grid.Column="3" Content="Clear All" Command="{Binding RemoveAll}" />
            <Button Grid.Column="4" Content="Select All" Command="{Binding SelectAll}" />
            <Button Grid.Column="5" Content="Upload" Command="{Binding StartUpload}" IsEnabled="{Binding !IsUploading}"
                    Classes="accent" />
            <Button Grid.Column="6" Content="Close" Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
