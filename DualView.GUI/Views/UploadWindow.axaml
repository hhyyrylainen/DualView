<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DualView.GUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="DualView.GUI.Views.UploadWindow"
        x:DataType="vm:UploadWindowViewModel"
        Title="Upload Files"
        Width="600" Height="400" WindowStartupLocation="CenterOwner">

    <Design.DataContext>
        <vm:UploadWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto, Auto" Margin="10">
        <Button Content="Add Files" Click="OnAddFilesClick" IsEnabled="{Binding !IsUploading}" />

        <ListBox Grid.Row="1" ItemsSource="{Binding FilesToUpload}" Margin="0,10,0,10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*, 150">
                        <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <ProgressBar Grid.Row="2" Value="{Binding TotalProgress}" Minimum="0" Maximum="1" 
                     IsVisible="{Binding IsUploading}" Margin="0,0,0,10" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="Upload" Command="{Binding StartUpload}" IsEnabled="{Binding !IsUploading}" Classes="accent" />
            <Button Content="Close" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
