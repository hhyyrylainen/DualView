<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualView.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:DualView.GUI.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        MinWidth="200" MinHeight="300"
        Height="1000" Width="800"
        x:Class="DualView.GUI.Views.ImageViewerWindow"
        x:DataType="vm:ImageViewerWindowViewModel"
        DragDrop.AllowDrop="True"
        Icon="/Assets/logo.ico"
        Title="{Binding Title}">

    <Design.DataContext>
        <vm:ImageViewerWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="*,40" DragDrop.AllowDrop="True" Background="Transparent">

        <ContentControl Grid.Row="0" Grid.Column="0" DataContext="{Binding Media}">
            <controls:MediaViewer />
        </ContentControl>

        <!-- Bottom bar -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto"
              Background="#F0F0F0">

            <ContentControl Grid.Column="0" Margin="6,0"
                            VerticalAlignment="Center" DataContext="{Binding Hamburger}">
                <controls:HamburgerMenuControl />
            </ContentControl>

            <TextBlock Grid.Column="2"
                       Text="{Binding ImageInfo}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="10,0,0,0" />

            <CheckBox Grid.Column="3" IsChecked="{Binding Media.PlayAudio}"
                      IsVisible="{Binding Media.HasAudio}"
                      Margin="5,0"
                      ToolTip.Tip="Enable audio playback for this video">
                Sound
            </CheckBox>

            <TextBox Grid.Column="4" IsVisible="{Binding IsTemporary}"
                      ToolTip.Tip="Use the Import window to import this media to a collection to make it permanent; otherwise it will be deleted after a while">
                Temporary Import
            </TextBox>

            <Button Grid.Column="5"
                    Content="Close"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Name="CloseButton" />
        </Grid>
    </Grid>
</Window>
