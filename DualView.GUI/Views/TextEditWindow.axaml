<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualView.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="600" Height="800"
        MinHeight="300" MinWidth="450"
        x:Class="DualView.GUI.Views.TextEditWindow"
        x:DataType="vm:TextEditWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="{Binding Title}">

    <Design.DataContext>
        <vm:TextEditWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Row="0">Modify text and save:</TextBlock>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Margin="0 2">
            <TextBox Text="{Binding TextToEdit}" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" Margin="2 0 5 0"/>
        </ScrollViewer>
        <TextBlock Grid.Row="2" IsVisible="{Binding Error,Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="3">
            <Button Command="{Binding TrySave}" IsEnabled="{Binding CanSave}">
                Save
            </Button>
            <Button Command="{Binding Cancel}">Cancel</Button>
        </StackPanel>
    </Grid>
</Window>
