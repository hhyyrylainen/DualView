<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DualView.GUI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        Width="800" Height="600"
        x:Class="DualView.GUI.Views.TagManagerWindow"
        x:DataType="vm:TagManagerWindowViewModel"
        Title="Tag Manager">

    <Design.DataContext>
        <vm:TagManagerWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*, 2*">
        <!-- Left: Search and List -->
        <Grid RowDefinitions="Auto, *" Margin="10">
            <StackPanel Grid.Row="0" Spacing="5">
                <TextBlock Text="Search Tags" FontWeight="Bold" />
                <TextBox Text="{Binding SearchString}" PlaceholderText="Enter tag name..." />
            </StackPanel>

            <ListBox Grid.Row="1" ItemsSource="{Binding FoundTags}" SelectedItem="{Binding SelectedTag}" Margin="0,10,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Right: Create/Edit -->
        <ScrollViewer Grid.Column="1" Margin="10">
            <StackPanel Spacing="20">
                <!-- Create New Tag -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Create New Tag" FontWeight="Bold" FontSize="16" />
                        
                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewTagName}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,10,10,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TagCategories}" 
                                      SelectedItem="{Binding NewTagCategory}" Margin="0,10,0,0" HorizontalAlignment="Stretch" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Description:" VerticalAlignment="Top" Margin="0,10,10,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NewTagDescription}" 
                                     AcceptsReturn="True" Height="60" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Aliases:" VerticalAlignment="Top" Margin="0,10,10,0" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding NewTagAliases}" 
                                     AcceptsReturn="True" Height="60" PlaceholderText="One per line" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Implies:" VerticalAlignment="Top" Margin="0,10,10,0" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding NewTagImplies}" 
                                     AcceptsReturn="True" Height="60" PlaceholderText="One per line" Margin="0,10,0,0" />

                            <CheckBox Grid.Row="5" Grid.Column="1" Content="Is Private" IsChecked="{Binding NewTagIsPrivate}" Margin="0,10,0,0" />
                        </Grid>

                        <Button Content="Create Tag" Command="{Binding CreateNewTag}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>

                <!-- Edit Selected Tag -->
                <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" IsVisible="{Binding IsEditing}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Edit Tag" FontWeight="Bold" FontSize="16" />

                        <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditTagName}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,10,10,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding TagCategories}" 
                                      SelectedItem="{Binding EditTagCategory}" Margin="0,10,0,0" HorizontalAlignment="Stretch" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Description:" VerticalAlignment="Top" Margin="0,10,10,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditTagDescription}" 
                                     AcceptsReturn="True" Height="60" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Aliases:" VerticalAlignment="Top" Margin="0,10,10,0" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EditTagAliases}" 
                                     AcceptsReturn="True" Height="60" Margin="0,10,0,0" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Implies:" VerticalAlignment="Top" Margin="0,10,10,0" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EditTagImplies}" 
                                     AcceptsReturn="True" Height="60" Margin="0,10,0,0" />

                            <CheckBox Grid.Row="5" Grid.Column="1" Content="Is Private" IsChecked="{Binding EditTagIsPrivate}" Margin="0,10,0,0" />
                        </Grid>

                        <Button Content="Save Changes" Command="{Binding SaveEditedTag}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
