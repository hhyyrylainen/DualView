<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualView.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:DualView.GUI.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        Width="1400" Height="800"
        MinHeight="300" MinWidth="700"
        x:Class="DualView.GUI.Views.MediaEditorWindow"
        x:DataType="vm:MediaEditorWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="DualView - Media Editor">

    <Design.DataContext>
        <vm:MediaEditorWindowViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto">
        <TabControl Grid.ColumnSpan="3" IsVisible="{Binding !Loading}">
            <TabItem Header="Edit">
                <SplitView IsPaneOpen="True"
                           DisplayMode="Inline"
                           OpenPaneLength="300">
                    <SplitView.Pane>
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden">
                            <StackPanel>
                                <Expander VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        Cropping
                                    </Expander.Header>
                                    <StackPanel>
                                        <TextBlock Margin="0 0 0 0" TextAlignment="Center">Left</TextBlock>
                                        <Slider Minimum="0" Maximum="{Binding MaxCropLeft}" Value="{Binding CropLeft}"></Slider>
                                        <TextBox Text="{Binding CropLeft}" />

                                        <TextBlock Margin="0 25 0 0" TextAlignment="Center">Right</TextBlock>
                                        <Slider Minimum="0" Maximum="{Binding MaxCropRight}"
                                                Value="{Binding CropRight}">
                                        </Slider>
                                        <TextBox Text="{Binding CropRight}" />

                                        <TextBlock Margin="0 25 0 0" TextAlignment="Center">Top</TextBlock>
                                        <Slider Minimum="0" Maximum="{Binding MaxCropTop}" Value="{Binding CropTop}"></Slider>
                                        <TextBox Text="{Binding CropTop}" />

                                        <TextBlock Margin="0 25 0 0" TextAlignment="Center">Bottom</TextBlock>
                                        <Slider Minimum="0" Maximum="{Binding MaxCropBottom}"
                                                Value="{Binding CropBottom}">
                                        </Slider>
                                        <TextBox Text="{Binding CropBottom}" />

                                        <ToggleButton Margin="0 15 0 0" IsChecked="{Binding MouseCropMode}"
                                                      HorizontalAlignment="Center">
                                            Mouse Crop Mode
                                        </ToggleButton>
                                    </StackPanel>
                                </Expander>

                                <Expander VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                    <Expander.Header>
                                        Animation
                                    </Expander.Header>
                                    <StackPanel>
                                        <CheckBox IsEnabled="False">Cut Start Frames</CheckBox>
                                    </StackPanel>
                                </Expander>

                                <TextBlock HorizontalAlignment="Center" Margin="0 15 0 4">
                                    Calculated Stats
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Text="{Binding CalculatedStatsStr}" Margin="3" />
                            </StackPanel>
                        </ScrollViewer>
                    </SplitView.Pane>

                    <ContentControl DataContext="{Binding  MainMediaPreview}" HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                        <controls:MediaViewer PointerPressed="OnPointerPressed"
                                              PointerMoved="OnPointerMoved" />
                    </ContentControl>
                </SplitView>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Column="0" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"
                   IsVisible="{Binding Loading}">
            Loading...
        </TextBlock>
        <ContentControl Grid.Column="0" Grid.Row="1" DataContext="{Binding Hamburger}" HorizontalAlignment="Left">
            <controls:HamburgerMenuControl />
        </ContentControl>

        <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal">
            <Button Margin="2 0" Command="{Binding SaveChanges}"
                    Background="{DynamicResource ToggleButtonBackgroundChecked}"
                    Foreground="{DynamicResource ToggleButtonForegroundChecked}"
                    IsEnabled="{Binding HasUnsavedChanges}">
                Save
            </Button>
        </StackPanel>
    </Grid>
</Window>
