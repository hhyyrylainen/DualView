<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:DualView.GUI.ViewModels"
        xmlns:controls="clr-namespace:DualView.GUI.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="DualView.GUI.Views.ReorderWindow"
        x:DataType="vm:ReorderWindowViewModel"
        Title="Reorder Collection">

    <Design.DataContext>
        <vm:ReorderWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="*, Auto" Margin="10">
        <Grid ColumnDefinitions="*, Auto, *">
            <!-- Main List -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Main List" FontWeight="Bold" Margin="0,0,0,5" />
                <ListBox ItemsSource="{Binding MainList}" SelectionMode="Multiple">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:MediaViewer Width="120" Height="160" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Middle Buttons -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10" Spacing="10">
                <Button Content="&gt;&gt;" Command="{Binding MoveToWorkspace}" />
                <Button Content="&lt;&lt;" Command="{Binding MoveFromWorkspace}" />
            </StackPanel>

            <!-- Workspace -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Workspace" FontWeight="Bold" Margin="0,0,0,5" />
                <ListBox ItemsSource="{Binding Workspace}" SelectionMode="Multiple">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:MediaViewer Width="120" Height="160" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Apply" Command="{Binding Apply}" Classes="accent" />
            <Button Content="Close" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
