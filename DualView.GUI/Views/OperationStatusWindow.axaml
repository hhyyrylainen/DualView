<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DualView.GUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="DualView.GUI.Views.OperationStatusWindow"
        Width="400" Height="200"
        MinHeight="100" MinWidth="100"
        x:DataType="vm:OperationStatusWindowViewModel"
        Icon="/Assets/logo.ico"
        Title="DualView - Progress">

    <Design.DataContext>
        <vm:OperationStatusWindowViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto,*">
        <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="5" Text="Waiting for status update..."
                   IsVisible="{Binding StatusMessage,Converter={x:Static ObjectConverters.IsNull}}"
                   FontSize="20"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center" />

        <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="5" Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage,Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   VerticalAlignment="Center" TextWrapping="Wrap"
                   HorizontalAlignment="Center" />

        <ProgressBar Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="5" Margin="5 5" Value="{Binding CompletionFraction}"
                     Minimum="0" Maximum="1"
                     IsVisible="{Binding StatusMessage,Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding SubMessage}"
                   IsVisible="{Binding StatusMessage,Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   TextWrapping="Wrap" Margin="3 4" MaxLines="3"
                   HorizontalAlignment="Center" />

        <TextBlock Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="5" TextWrapping="Wrap" HorizontalAlignment="Center"
                   Margin="1 3" Foreground="{StaticResource ErrorBrush}" Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage,Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        </TextBlock>

        <Button Grid.Column="1" Grid.Row="4" IsVisible="{Binding NotPausedAndNotCompleted}" Margin="2 0"
                Command="{Binding RequestPause}">
            Pause
        </Button>
        <Button Grid.Column="1" Grid.Row="4" IsVisible="{Binding Paused}" Margin="2 0"
                Command="{Binding RequestResume}">
            Resume
        </Button>
        <Button Grid.Column="2" Grid.Row="4" IsVisible="{Binding !Completed}" Margin="2 0"
                Command="{Binding RequestCancel}">
            Cancel
        </Button>
        <Button Grid.Column="2" Grid.Row="4" IsVisible="{Binding Completed}" Margin="2 0"
                Command="{Binding TryClose}">
            Close
        </Button>
        <Button Grid.Column="3" Grid.Row="4" IsVisible="{Binding ShowForceCloseButton}" Margin="2 0"
                Command="{Binding ForceClose}"
                ToolTip.Tip="Pressing this will close this progress window but will not cancel the operation. Press the cancel button if you want to cancel.">
            Force Close
        </Button>
    </Grid>
</Window>
